%% Pandoc template mirroring the Vanderbilt University Dissertation Template (2026)
%% https://www.overleaf.com/latex/templates/vanderbilt-university-dissertation-template-2026/bpfmrtczfgwj
%% Variables come from content/_data/thesis.yaml. Edit this file to match the
%% Graduate School's current formatting guidelines.
\documentclass[$if(fontsize)$$fontsize$$else$12pt$endif$]{report}

%% ---------- Page layout & fonts (as in the Overleaf template) ----------
\usepackage[$if(papersize)$$papersize$paper$else$letterpaper$endif$, margin=1in]{geometry}
\usepackage[T1]{fontenc}
\usepackage{mathptmx}
\usepackage{times}
\usepackage{amsmath,amssymb}
\usepackage{setspace}
\usepackage{graphicx}
\graphicspath{{Figures/}}
\usepackage{longtable,booktabs,array,calc}
\usepackage{etoolbox}
\usepackage{caption}
\IfFileExists{footnotehyper.sty}{\usepackage{footnotehyper}}{\usepackage{footnote}}
\makesavenoteenv{longtable}
\usepackage[$if(natbiboptions)$$natbiboptions$$else$authoryear$endif$]{natbib}
\bibliographystyle{$if(biblio-style)$$biblio-style$$else$apalike$endif$}
\usepackage{xurl}
\usepackage[hidelinks]{hyperref}
\usepackage{bookmark}

\setcounter{secnumdepth}{$if(secnumdepth)$$secnumdepth$$else$7$endif$}
\setcounter{tocdepth}{$if(secnumdepth)$$secnumdepth$$else$7$endif$}

%% ---------- Macros pandoc's LaTeX writer relies on ----------
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}
\makeatletter
\newsavebox\pandoc@box
\newcommand*\pandocbounded[1]{%
  \sbox\pandoc@box{#1}%
  \Gscale@div\@tempa{\textheight}{\dimexpr\ht\pandoc@box+\dp\pandoc@box\relax}%
  \Gscale@div\@tempb{\linewidth}{\wd\pandoc@box}%
  \ifdim\@tempb\p@<\@tempa\p@\let\@tempa\@tempb\fi
  \ifdim\@tempa\p@<\p@\scalebox{\@tempa}{\usebox\pandoc@box}\else\usebox{\pandoc@box}\fi}
\def\fps@figure{htbp}
\patchcmd\longtable{\par}{\if@noskipsec\mbox{}\fi\par}{}{}
\makeatother
$if(highlighting-macros)$
$highlighting-macros$
$endif$
\setlength{\emergencystretch}{3em}

%% References: single-spaced, titled per thesis.yaml, listed in the TOC
\renewcommand{\bibsection}{%
  \chapter*{$if(biblio-title)$$biblio-title$$else$References$endif$}%
  \addcontentsline{toc}{chapter}{$if(biblio-title)$$biblio-title$$else$References$endif$}}

\hypersetup{pdftitle={$title$}, pdfauthor={$author$}}
$for(header-includes)$
$header-includes$
$endfor$

\begin{document}

%% ---------- Title page (counted, number suppressed) ----------
\pagenumbering{alph}
\begin{titlepage}
\begin{center}
\begin{doublespace}
{\large $title$}\\[1em]
By\\[1em]
$author$\\[2em]
Dissertation\\
Submitted to the Faculty of the\\
Graduate School of Vanderbilt University\\
in partial fulfillment of the requirements\\
for the degree of\\[1em]
{\MakeUppercase{$degree$}}\\
in\\
$program$\\[1em]
$date$\\[1em]
$location$\\[2em]
\end{doublespace}
\end{center}
\begin{flushleft}
Approved:\\[0.5em]
$for(committee)$
$committee.name$$if(committee.chair)$ (Chair)$endif$\\
$endfor$
\end{flushleft}
\end{titlepage}

%% ---------- Front matter: single-spaced, roman numerals from ii ----------
\pagenumbering{roman}
\setcounter{page}{2}
\singlespacing
$if(copyright)$
\clearpage
\vspace*{\fill}
\begin{center}
$copyright$
\end{center}
\vspace*{\fill}
$endif$
$if(dedication)$
\clearpage
\vspace*{\fill}
\begin{center}
$dedication$
\end{center}
\vspace*{\fill}
$endif$
$if(acknowledgments)$
\chapter*{Acknowledgments}
\addcontentsline{toc}{chapter}{Acknowledgments}
$acknowledgments$
$endif$
$for(include-before)$
$include-before$
$endfor$
$if(toc)$
\tableofcontents
$endif$
$if(lot)$
\clearpage
\addcontentsline{toc}{chapter}{List of Tables}
\listoftables
$endif$
$if(lof)$
\clearpage
\addcontentsline{toc}{chapter}{List of Figures}
\listoffigures
$endif$

%% ---------- Body: double-spaced, arabic numbering from 1 ----------
\clearpage
\pagenumbering{arabic}
\doublespacing

$body$

%% ---------- Back matter ----------
\singlespacing
$if(bibliography)$
\bibliography{$for(bibliography)$$bibliography$$sep$,$endfor$}
$endif$
$for(include-after)$
$include-after$
$endfor$

\end{document}
