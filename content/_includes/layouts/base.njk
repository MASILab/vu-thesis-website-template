<!doctype html>
<html lang="en">
<head>
	<meta charset="utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1">
	<title>{% if title %}{{ title }} · {% endif %}{{ thesis.title }}</title>
	<link rel="stylesheet" href="/assets/katex/katex.min.css">
	<link rel="stylesheet" href="/assets/style.css">
</head>
<body>
	<header class="site-header"><a href="/">{{ thesis.title }}</a></header>
	<main>
		{{ content | safe }}
	</main>
	<footer class="site-footer">
		<p>
			© {{ thesis["copyright-year"] or buildYear }} {{ thesis.author }}.
			{% if thesis.license %}
			Licensed under {% if thesis.license.url %}<a href="{{ thesis.license.url }}" rel="license">{{ thesis.license.name }}</a>{% else %}{{ thesis.license.name }}{% endif %}.
			{% else %}
			All rights reserved.
			{% endif %}
		</p>
	</footer>
</body>
</html>
