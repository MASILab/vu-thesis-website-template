---
layout: layouts/base.njk
---
{%- set entry = collections.chapters | outlineEntry(page.url) -%}
{%- if entry.kind == "part" -%}
<article class="part">
	<h1><span class="chapter-num">{{ entry.label }}</span> {{ entry.title }}</h1>

	{{ content | citations | safe }}

{%- else -%}
<article class="chapter" style="--chapter: {{ entry.number }}">
	<h1><span class="chapter-num">{{ entry.label }}</span> {{ title }}</h1>

	{{ content | citations | safe }}
{%- endif %}

	{% if references and references.length %}
	<section class="references">
		<h2 class="unnumbered">References</h2>
		{% include "references.njk" %}
	</section>
	{% endif %}
</article>

<nav class="chapter-nav">
	{% set prev = collections.chapters | getPreviousCollectionItem %}
	{% set next = collections.chapters | getNextCollectionItem %}
	{% if prev %}<a rel="prev" href="{{ prev.url }}">← Previous</a>{% endif %}
	{% if next %}<a rel="next" href="{{ next.url }}">Next →</a>{% endif %}
</nav>
