---
layout: layouts/base.njk
---
<section class="title-page">
	<h1>{{ thesis.title }}</h1>
	<p>{{ thesis.author }}</p>
	<p>{{ thesis.degree }} in {{ thesis.major }} · Vanderbilt University</p>
	<p>{{ thesis.date }}</p>
</section>

<nav class="toc">
	<h2>Contents</h2>
	<ol class="toc-list">
	{% for e in collections.chapters | outline %}
		<li class="toc-{{ e.kind }}{{ ' in-part' if e.part }}"><a href="{{ e.url }}"><span class="toc-num">{{ e.label if e.kind == "part" else e.number }}</span> {{ e.title }}</a></li>
	{% endfor %}
	</ol>
</nav>
